    {
      "id": "S1",
      "title": "Variable deleted by another thread (diagram scenario: main-owned var shared by T1 and T2)",
      "class": "DELETE_RACE",
      "error_log": {
        "function": "CWorkerService::q2",
        "level": "ERROR",
        "message_regex": "Exception occured: Unknown exception",
        "min_count": 2
      },
      "thread_roots": {
        "CWorkerService::q2": "CWorkerService::q1",
        "CResourceOwner::q3": "CResourceOwner::q3"
      },
      "must_have_roles": [
        "victim",
        "culprit",
        "alloc",
        "spawn"
      ],
      "expects_cross_thread_evidence": true,
      "expected_conclusion": "CResourceOwner::q3 (thread T2) deletes var and sets it to nullptr while CWorkerService::q2 (thread T1, via q1) still uses it. var is created in CScenarioRunner::runS1 and passed by std::ref to both threads. No lock or ownership rule protects it. q2 is only the failure site.",
      "wrong_conclusions": [
        "root cause is CWorkerService::q2",
        "the string 'Unknown exception' is the bad value",
        "a bug inside std::thread"
      ],
      "edges": [
        {
          "scenario": "S1",
          "role": "victim",
          "function": "CWorkerService::q2",
          "kind": "READ",
          "target": "var",
          "extra": {},
          "file": "src/file1_service.cpp",
          "line": 16
        },
        {
          "scenario": "S1",
          "role": "culprit",
          "function": "CResourceOwner::q3",
          "kind": "DELETE",
          "target": "var",
          "extra": {},
          "file": "src/file3_owner.cpp",
          "line": 9
        },
        {
          "scenario": "S1",
          "role": "alloc",
          "function": "CScenarioRunner::runS1",
          "kind": "NEW",
          "target": "var",
          "extra": {},
          "file": "src/main.cpp",
          "line": 53
        },
        {
          "scenario": "S1",
          "role": "spawn",
          "function": "CScenarioRunner::runS1",
          "kind": "SPAWN",
          "target": "CWorkerService::q1",
          "extra": {
            "args": "std::ref(var)"
          },
          "file": "src/main.cpp",
          "line": 57
        },
        {
          "scenario": "S1",
          "role": "spawn",
          "function": "CScenarioRunner::runS1",
          "kind": "SPAWN",
          "target": "CResourceOwner::q3",
          "extra": {
            "args": "std::ref(var)"
          },
          "file": "src/main.cpp",
          "line": 59
        }
      ]
